# Copy this file to .env.local and use your own Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Crackd.ai
NEXT_PUBLIC_ENVIRONMENT=development

# Supply the course-approved API endpoint if your workflow uses caption generation.
NEXT_PUBLIC_API_BASE_URL=

# Server-only. Leave false until llm_model_responses is reviewed: the caption API logs full
# prompts there, and anonymous clients can read that table in the restored database.
# Only the exact value true saves nudges. Any other value keeps nudges turned off.
ENABLE_NUDGE_PERSISTENCE=false

# Configure your own Google client if required by the course authentication setup.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
